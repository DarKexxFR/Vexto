# Copy this file to .env and fill in your own values.
# Expo loads .env automatically when you run `expo start` / `expo export`.

# Supabase project (Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-publishable-anon-key

# Mapbox public token (https://account.mapbox.com/access-tokens/), starts with pk.
MAPBOX_TOKEN=pk.your_public_token

# Real-time IDFM timetables: the PRIM API key is NOT stored here (it would end
# up in the public app). Set it as a Supabase secret instead:
#   npx supabase secrets set PRIM_API_KEY=...   (see README › Horaires temps réel)
